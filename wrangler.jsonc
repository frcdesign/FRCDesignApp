/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "frc-design-app",
    "main": "src/backend/index.ts",
    "compatibility_date": "2026-05-14",
    "assets": {
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        // Route app + API paths through the Worker; static assets bypass it
        "run_worker_first": ["/init", "/api/*", "/auth/*"]
    },
    "observability": {
        "enabled": true
    },
    // Use Workers Caching
    "cache": {
        "enabled": true
    },
    "upload_source_maps": true,
    "compatibility_flags": ["nodejs_compat"],
    /**
     * Smart Placement
     * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
     */
    // "placement": {  "mode": "smart" }
    /**
     * Bindings
     * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
     * databases, object storage, AI inference, real-time communication and more.
     * https://developers.cloudflare.com/workers/runtime-apis/bindings/
     */
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "frc-design-app-dev-db",
            "migrations_dir": "drizzle"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "KV",
            "id": "8e77565b50314aa28be8246d6a19d1f1"
        }
    ],
    "r2_buckets": [
        {
            "binding": "BLOB",
            "bucket_name": "frc-design-app-dev-blob"
        }
    ],
    "workflows": [
        {
            "name": "load-library-workflow",
            "binding": "LOAD_LIBRARY_WORKFLOW",
            "class_name": "LoadLibraryWorkflow"
        },
        {
            "name": "add-group-workflow",
            "binding": "ADD_GROUP_WORKFLOW",
            "class_name": "AddGroupWorkflow"
        },
        {
            "name": "thumbnail-workflow",
            "binding": "THUMBNAIL_WORKFLOW",
            "class_name": "ThumbnailWorkflow"
        }
    ],
    /**
     * Environment Variables
     * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
     * Note: Use secrets to store sensitive data.
     * https://developers.cloudflare.com/workers/configuration/secrets/
     */
    "vars": {
        // Onshape team ID used to determine editor/admin access level in production
        "ADMIN_TEAM": "5b620150b2190f0fca90ec10",
        "NODE_ENV": "development"
    },
    /**
     * Service Bindings (communicate between multiple Workers)
     * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
     */
    /**
     * Deployed environments. Bindings and vars are non-inheritable, so each environment
     * redeclares its full set. Deploy with `wrangler deploy --env <name>`.
     */
    "env": {
        "cert": {
            "cache": {
                "enabled": true
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "frc-design-app-cert-db",
                    "database_id": "c6325e51-5aef-47de-bdf4-c7bcd6a69e6b",
                    "migrations_dir": "drizzle"
                }
            ],
            "kv_namespaces": [
                {
                    "binding": "KV",
                    "id": "8e77565b50314aa28be8246d6a19d1f1"
                }
            ],
            "r2_buckets": [
                {
                    "binding": "BLOB",
                    "bucket_name": "frc-design-app-cert-blob"
                }
            ],
            "workflows": [
                {
                    "name": "load-library-workflow-cert",
                    "binding": "LOAD_LIBRARY_WORKFLOW",
                    "class_name": "LoadLibraryWorkflow"
                },
                {
                    "name": "add-group-workflow-cert",
                    "binding": "ADD_GROUP_WORKFLOW",
                    "class_name": "AddGroupWorkflow"
                },
                {
                    "name": "thumbnail-workflow-cert",
                    "binding": "THUMBNAIL_WORKFLOW",
                    "class_name": "ThumbnailWorkflow"
                }
            ],
            "vars": {
                "ADMIN_TEAM": "6a62e6efcc21741bea57362c",
                // Production, not because cert is production, but because
                // FORCE_SIGNED_IN and VITE_ACCESS_LEVEL_OVERRIDE are gated on
                // this alone: anything but "production" leaves them armed.
                "NODE_ENV": "production"
            },
            "limits": {
                "subrequests": 1000
            }
        },
        "production": {
            "cache": {
                "enabled": true
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "frc-design-app-prod-db",
                    "database_id": "a50ef115-925e-44d1-817a-2b58c0e68934",
                    "migrations_dir": "drizzle"
                }
            ],
            "kv_namespaces": [
                {
                    "binding": "KV",
                    "id": "659e919411f847529a0b0b8cb72ee61b"
                }
            ],
            "r2_buckets": [
                {
                    "binding": "BLOB",
                    "bucket_name": "frc-design-app-prod-blob"
                }
            ],
            "workflows": [
                {
                    "name": "load-library-workflow-prod",
                    "binding": "LOAD_LIBRARY_WORKFLOW",
                    "class_name": "LoadLibraryWorkflow"
                },
                {
                    "name": "add-group-workflow-prod",
                    "binding": "ADD_GROUP_WORKFLOW",
                    "class_name": "AddGroupWorkflow"
                },
                {
                    "name": "thumbnail-workflow-prod",
                    "binding": "THUMBNAIL_WORKFLOW",
                    "class_name": "ThumbnailWorkflow"
                }
            ],
            "vars": {
                "ADMIN_TEAM": "5b620150b2190f0fca90ec10",
                "NODE_ENV": "production"
            },
            "limits": {
                "subrequests": 100000
            }
        }
    }
}
