{
    "compilerOptions": {
        "paths": {
            "@backend/*": ["./src/backend/*"],
            "@frontend/*": ["./src/frontend/*"]
        },
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
        "target": "es2024",
        "lib": ["ES2024", "DOM"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "types": [
            "vitest/globals",
            "node",
            "vite/client",
            "@cloudflare/vitest-pool-workers/types",
            "./worker-configuration.d.ts"
        ],
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    // The route tree and router declare the routes, which a test importing one needs.
    "include": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/__test_utils__",
        "src/frontend/routeTree.gen.ts",
        "src/frontend/router.ts"
    ]
}
