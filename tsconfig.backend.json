{
    "extends": "./tsconfig.node.json",
    "compilerOptions": {
        "paths": {
            "@backend/*": ["./src/backend/*"],
            "@frontend/*": ["./src/frontend/*"]
        },
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.backend.tsbuildinfo",
        "types": ["node", "./worker-configuration.d.ts"]
    },
    "include": ["src/backend"],
    "exclude": ["src/backend/**/*.test.ts"]
}
